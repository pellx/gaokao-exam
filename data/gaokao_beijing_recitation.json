              ],
              "answers": [
                {
                  "text": "出师未捷身先死",
                  "work_title": "蜀相",
                  "author": "杜甫"
                },
                {
                  "text": "长使英雄泪满襟",
                  "work_title": "蜀相",
                  "author": "杜甫"
                }
              ],
              "alternate_answers": [],
              "answer_status": "provided",
