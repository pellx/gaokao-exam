          ],
          "items": [
            {
              "label": "（1）",
              "context": "诗歌之妙在言有尽而意无穷。李商隐就善于表现含蓄蕴藉之美，如《锦瑟》中间两联：“庄生晓梦迷蝴蝶，望帝春心托杜鹃。__________，__________。”",
              "works": [
                {
                  "title": "锦瑟",
                  "author": "李商隐"
                }
              ],
              "answers": [
                {
                  "text": "沧海月明珠有泪",
                  "work_title": "锦瑟",
                  "author": "李商隐"
                },
                {
                  "text": "蓝田日暖玉生烟",
                  "work_title": "锦瑟",
                  "author": "李商隐"
                }
              ],
              "alternate_answers": [],
              "answer_status": "provided",
              "answer_pages": []
            },
            {
              "label": "（2）",
              "context": "姜夔在《扬州慢》中描写了兵乱后扬州的沧桑变化：“__________，__________。自胡马窥江去后，废池乔木，犹厌言兵。”",
              "works": [
                {
                  "title": "扬州慢",
                  "author": "姜夔"
                }
              ],
              "answers": [
                {
                  "text": "过春风十里",
                  "work_title": "扬州慢",
                  "author": "姜夔"
                },
                {
                  "text": "尽荠麦青青",
                  "work_title": "扬州慢",
                  "author": "姜夔"
                }
              ],
              "alternate_answers": [],
              "answer_status": "provided",
              "answer_pages": []
            },
            {
              "label": "（3）",
              "context": "近代以来，中华民族饱受列强欺凌，因此绝不会将自己曾经遭受的苦难强加给其他国家与民族，正如《论语》所谓：“__________，__________。”",
              "works": [
                {
                  "title": "论语",
                  "author": null
                }
              ],
              "answers": [
                {
                  "text": "己所不欲",
                  "work_title": "论语",
                  "author": null
                },
                {
                  "text": "勿施于人",
                  "work_title": "论语",
                  "author": null
                }
              ],
              "alternate_answers": [
                {
                  "label": "或",
                  "answers": [
                    {
                      "text": "我不欲人之加诸我也",
                      "work_title": "论语",
                      "author": null
                    },
                    {
                      "text": "吾亦欲无加诸人",
                      "work_title": "论语",
                      "author": null
                    }
                  ]
                }
              ],
              "answer_status": "provided",
              "answer_pages": []
            },
            {
              "label": "（4）",
              "context": "每个人都难免有自己的知识盲区，遇到不懂的领域，应该虚心听取专业人士的意见，正如《师说》所谓：“__________，__________。”",
              "works": [
                {
                  "title": "师说",
                  "author": "韩愈"
                }
              ],
              "answers": [
                {
                  "text": "道之所存",
                  "work_title": "师说",
                  "author": "韩愈"
                },
                {
                  "text": "师之所存也",
                  "work_title": "师说",
                  "author": "韩愈"
                }
              ],
              "alternate_answers": [
