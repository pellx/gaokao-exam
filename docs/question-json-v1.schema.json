{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exam Questions JSON v1",
  "description": "Normalized exam questions with shared materials, reusable options, linked assets, and nested question parts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "paper", "source", "extraction", "questions"],
  "properties": {
    "format": {
      "const": "exam-questions/v1"
    },
    "paper": {
      "$ref": "#/$defs/paper"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "extraction": {
      "$ref": "#/$defs/extraction"
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^a[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "materials": {
      "type": "object",
      "propertyNames": {
        "pattern": "^m[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/material"
      }
    },
    "option_sets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^o[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/option"
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "year", "kind", "subject"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable paper identifier. In this repository, use the existing entry_key."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Exam batch, such as 零模、一模、二模、三模."
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "district": {
          "type": "string",
          "minLength": 1
        },
        "school": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "academic_year": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}$"
        },
        "exam_date": {
          "type": "string",
          "minLength": 4,
          "description": "ISO 8601 date or partial date when printed on the paper; do not infer it."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "answer_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "sha256"],
            "properties": {
              "file": {
                "$ref": "#/$defs/relativePath"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["draft", "needs_review", "verified"]
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9_./-]+\\.(?:png|jpe?g|webp|gif|svg|mp3|wav|m4a|pdf)$",
          "not": {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          },
          "description": "POSIX-style path relative to paper.json, inside the sibling assets directory."
        },
        "kind": {
          "enum": ["image", "audio", "attachment"]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          },
          "description": "Optional source crop rectangle [x0,y0,x1,y1] in PDF points from the page's top-left."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "content"],
      "properties": {
        "kind": {
          "enum": ["passage", "instructions", "data", "situation", "option_description", "listening_transcript", "other"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "pages": {
          "$ref": "#/$defs/pages"
        },
        "needs_review": {
          "type": "boolean"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "content"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Unique among siblings. Recommended: q001 at top level and p1, p2 inside parts."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Original printed label, not a renumbered value."
        },
        "type": {
          "enum": ["single_choice", "multiple_choice", "true_false", "fill_blank", "short_answer", "calculation", "proof", "translation", "essay", "matching", "ordering", "drawing", "composite", "other"]
        },
        "type_original": {
          "type": "string",
          "minLength": 1
        },
        "stem": {
          "$ref": "#/$defs/content"
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^m[A-Za-z0-9_-]+$"
          }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "option_set": {
          "type": "string",
          "pattern": "^o[A-Za-z0-9_-]+$"
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "analysis": {
          "$ref": "#/$defs/content"
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "pages": {
          "$ref": "#/$defs/pages"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "needs_review": {
          "type": "boolean"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "extensions": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["options", "option_set"]
          }
        },
        {
          "if": {
            "required": ["parts"]
          },
          "then": {
            "properties": {
              "type": {
                "const": "composite"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "composite"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["parts"]
          }
        }
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "enum": ["question_document", "answer_document", "inferred"]
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "content": {
                "$ref": "#/$defs/content"
              },
              "score": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": ["choices"]
        },
        {
          "required": ["content"]
        },
        {
          "required": ["pairs"]
        },
        {
          "required": ["rubric"]
        }
      ]
    },
    "content": {
      "description": "A Markdown/LaTeX string for one block, or an array of strings, asset references, and tables.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      ]
    },
    "block": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset"],
          "properties": {
            "asset": {
              "type": "string",
              "pattern": "^a[A-Za-z0-9_-]+$"
            },
            "caption": {
              "type": "string",
              "minLength": 1
            },
            "inline": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["table"],
          "properties": {
            "table": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rows"],
              "properties": {
                "caption": {
                  "type": "string",
                  "minLength": 1
                },
                "header": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/content"
                  }
                },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/content"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:[A-Za-z]:[\\\\/]|/|\\\\\\\\|https?://|data:)"
      },
      "description": "Relative to paper.json, using forward slashes. Parent-directory references are allowed for original source documents."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
