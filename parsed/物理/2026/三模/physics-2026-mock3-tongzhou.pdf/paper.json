        "m001"
      ],
      "options": [
        {
          "key": "A",
          "content": "袋内气体压强减小"
        },
        {
          "key": "B",
          "content": "外界对气体做正功"
        },
        {
          "key": "C",
          "content": "气体分子数密度不变"
        },
        {
          "key": "D",
          "content": "气体分子平均动能增大"
        }
