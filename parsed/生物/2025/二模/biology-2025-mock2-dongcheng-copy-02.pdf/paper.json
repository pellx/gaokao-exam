        {
          "key": "B",
          "content": "无机盐参与维持细胞的酸碱平衡，不参与有机物的合成"
        },
        {
          "key": "C",
          "content": "乳糖存在于动物细胞中，不能进一步水解为更简单的化合物"
        },
        {
          "key": "D",
          "content": "脂肪是细胞中良好的储能物质，不是细胞膜的主要组成组分"
        }
      ],
      "answer": {
        "source": "question_document",
        "choices": [
