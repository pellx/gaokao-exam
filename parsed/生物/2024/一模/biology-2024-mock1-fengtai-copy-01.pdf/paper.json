        {
          "key": "A",
          "content": "二者都含有蛋白质和核酸"
        },
        {
          "key": "B",
          "content": "二者都是独立的生命系统"
        },
        {
          "key": "C",
          "content": "流感病毒在呼吸道细胞内通过分裂增殖"
        },
        {
          "key": "D",
          "content": "治疗支原体的抗生素也能治疗流感病毒"
        }
      ],
      "answer": {
        "source": "question_document",
        "choices": [
          "A"
        ]
      },
      "score": 2,
      "pages": [
        1
