  "questions": [
    {
      "id": "q001",
      "label": "1",
      "type": "single_choice",
      "stem": "流感病毒和肺炎支原体都是引发急性呼吸道传染病的常见病原体。以下关于两种病原体的说法正确的是",
      "options": [
        {
          "key": "A",
          "content": "二者都含有蛋白质和核酸"
        },
        {
          "key": "B",
          "content": "二者都是独立的生命系统"
        },
        {
          "key": "C",
          "content": "流感病毒在呼吸道细胞内通过分裂增殖"
        },
        {
          "key": "D",
          "content": "治疗支原体的抗生素也能治疗流感病毒"
        }
      ],
      "answer": {
        "source": "question_document",
        "choices": [
          "A"
        ]
      },
      "score": 2,
      "pages": [
        1
      ]
    },
    {
      "id": "q002",
      "label": "2",
      "type": "single_choice",
      "stem": [
        "无氧运动产生的乳酸会导致肌肉酸胀乏力，乳酸在肌肉和肝脏中的部分代谢过程如下图。下列叙述错误的是",
        {
          "asset": "a001"
        }
      ],
      "options": [
        {
          "key": "A",
          "content": "无氧运动时丙酮酸分解为乳酸可以为肌细胞迅速供能"
        },
        {
          "key": "B",
          "content": "肌细胞无氧呼吸产生的乳酸能在肝脏中再次转化为葡萄糖"
        },
        {
          "key": "C",
          "content": "肌细胞中肌糖原不能分解产生葡萄糖可能是缺乏相关的酶"
        },
        {
          "key": "D",
          "content": "乳酸在肝脏中的代谢过程可防止乳酸堆积引起酸中毒"
        }
      ],
      "answer": {
        "source": "question_document",
        "choices": [
          "A"
