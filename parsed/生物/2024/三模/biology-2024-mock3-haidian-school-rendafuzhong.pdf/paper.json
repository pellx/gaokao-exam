    {
      "id": "q001",
      "label": "1",
      "type": "single_choice",
      "stem": "细胞色素C是细胞内普遍含有的一种蛋白质，约有104个氨基酸。它是一种线粒体内膜蛋白，参与将[H]中电子传递给氧气的过程。据推算，它的氨基酸序列每2000万年才发生1%的改变。下列关于细胞色素C的叙述不正确的是（　　）",
      "options": [
        {
          "key": "A",
          "content": "可由C、H、O、N等元素组成"
        },
        {
          "key": "B",
          "content": "是一种能催化ATP分解的蛋白质"
        },
        {
          "key": "C",
          "content": "是一种由单体所组成的生物大分子"
        },
        {
          "key": "D",
          "content": "其序列相似性可作为生物进化的证据"
        }
      ],
      "answer": {
        "source": "question_document",
        "choices": [
          "B"
        ]
      },
      "pages": [
