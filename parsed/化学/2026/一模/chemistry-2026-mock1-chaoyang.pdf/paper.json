    {
      "id": "q005",
      "label": "5",
      "type": "single_choice",
      "materials": [
        "m001",
        "m002"
      ],
      "stem": [
        "将分别蘸有浓氨水和浓盐酸的玻璃棒靠近，产生大量白烟。下列说法不正确的是",
        {
          "asset": "a004"
        }
      ],
      "options": [
        {
          "key": "A",
          "content": "$\\mathrm{NH_3}$、$\\mathrm{HCl}$ 中的共价键分别是 $\\mathrm{s\\text{-}sp^3}$ σ键、$\\mathrm{s\\text{-}p}$ σ键"
        },
        {
          "key": "B",
          "content": "反应过程涉及配位键的形成"
        },
        {
          "key": "C",
          "content": "白烟的产生体现了 $\\mathrm{NH_3}$ 的还原性"
        },
        {
          "key": "D",
          "content": "用浓硝酸代替浓盐酸，也会产生大量白烟"
        }
      ],
      "answer": {
        "source": "question_document",
        "choices": [
          "C"
        ]
      },
      "score": 3,
      "pages": [
        2
