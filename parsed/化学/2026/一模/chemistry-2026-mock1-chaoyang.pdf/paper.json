    {
      "id": "q006",
      "label": "6",
      "type": "single_choice",
      "materials": [
        "m001",
        "m002"
      ],
      "stem": "下列方程式与所给事实不相符的是",
      "options": [
        {
          "key": "A",
          "content": "将 $\\mathrm{NO_2}$ 通入水中制得硝酸：$3\\mathrm{NO_2}+\\mathrm{H_2O}=2\\mathrm{HNO_3}+\\mathrm{NO}$"
        },
        {
          "key": "B",
          "content": "用 $\\mathrm{NaOH}$ 溶液吸收少量 $\\mathrm{SO_2}$：$\\mathrm{SO_2}+2\\mathrm{OH^-}=\\mathrm{SO_3^{2-}}+\\mathrm{H_2O}$"
        },
        {
          "key": "C",
          "content": "用催化转化器处理汽车尾气中的 $\\mathrm{CO}$ 和 $\\mathrm{NO}$：$2\\mathrm{CO}+2\\mathrm{NO}\\xrightarrow[{\\Delta}]{\\text{催化剂}}\\mathrm{N_2}+2\\mathrm{CO_2}$"
        },
        {
          "key": "D",
          "content": "将 $\\mathrm{CO_2}$ 通入苯酚钠溶液中产生浑浊：$2\\mathrm{C_6H_5ONa}+\\mathrm{CO_2}+\\mathrm{H_2O}\\rightarrow 2\\mathrm{C_6H_5OH}+\\mathrm{Na_2CO_3}$"
        }
      ],
      "answer": {
        "source": "question_document",
        "choices": [
          "D"
        ]
      },
      "score": 3,
      "pages": [
        2
      ],
      "notes": [
        "D项原卷以苯环结构式表示苯酚钠和苯酚，此处按等价缩合式转录。"
      ]
    },
