          ]
        },
        {
          "key": "C",
          "content": [
            "$\\mathrm{sp^2}$ 杂化轨道示意图：",
            {
              "asset": "a003"
            }
          ]
        },
        {
          "key": "D",
          "content": "异丙基的结构简式：$\\mathrm{-CH(CH_3)_2}$"
        }
      ],
      "answer": {
