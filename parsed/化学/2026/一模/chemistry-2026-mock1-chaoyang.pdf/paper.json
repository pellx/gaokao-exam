  "questions": [
    {
      "id": "q001",
      "label": "1",
      "type": "single_choice",
      "materials": [
        "m001",
        "m002"
      ],
      "stem": "我国科学家首次利用反应 $2\\mathrm{AgN_3}+\\mathrm{Br_2}=2\\mathrm{AgBr}+\\mathrm{N_6}$ 合成了储能材料 $\\mathrm{N_6}$。$\\mathrm{N_6}$ 为链状分子，能分解为更稳定的 $\\mathrm{N_2}$。下列说法不正确的是",
      "options": [
        {
          "key": "A",
          "content": "基态氮原子的电子排布式为 $1s^22s^22p^3$"
        },
        {
          "key": "B",
          "content": "$\\mathrm{N_6}$ 与 $\\mathrm{N_2}$ 互为同素异形体"
        },
        {
          "key": "C",
          "content": "合成 $\\mathrm{N_6}$ 的反应属于置换反应"
        },
        {
          "key": "D",
          "content": "$\\mathrm{N_6}$ 分解为 $\\mathrm{N_2}$ 是熵减的过程"
        }
      ],
      "answer": {
        "source": "question_document",
        "choices": [
          "D"
        ]
      },
      "score": 3,
      "pages": [
        1
      ]
    },
    {
      "id": "q002",
      "label": "2",
      "type": "single_choice",
      "materials": [
        "m001",
        "m002"
      ],
      "stem": "下列化学用语或图示表达不正确的是",
