        "m002"
      ],
      "stem": "下列关于ⅡA族元素的氢氧化物的说法不正确的是",
      "options": [
        {
          "key": "A",
          "content": "碱性：$\\mathrm{Ba(OH)_2>Ca(OH)_2}$"
        },
        {
          "key": "B",
          "content": "用 $\\mathrm{Ca(OH)_2}$ 除去粗盐中 $\\mathrm{SO_4^{2-}}$ 的效果比用 $\\mathrm{Ba(OH)_2}$ 好"
        },
        {
          "key": "C",
          "content": "加热 $\\mathrm{Ca(OH)_2}$ 与 $\\mathrm{NH_4Cl}$ 的固体混合物可制取 $\\mathrm{NH_3}$"
        },
        {
          "key": "D",
          "content": "将 $\\mathrm{Ba(OH)_2\\cdot 8H_2O}$ 晶体与 $\\mathrm{NH_4Cl}$ 晶体混合搅拌，体系从环境吸收热量"
        }
      ],
      "answer": {
        "source": "question_document",
        "choices": [
          "B"
        ]
      },
      "score": 3,
      "pages": [
        1
